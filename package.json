{
  "name": "voltcrawl",
  "version": "1.0.0",
  "description": "Verified web evidence and headless browser rendering for coding agents",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "type": "module",
  "license": "MIT",
  "author": "adi-IL <206920770+adi-IL@users.noreply.github.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/adi-IL/voltcrawl.git"
  },
  "homepage": "https://github.com/adi-IL/voltcrawl#readme",
  "bugs": "https://github.com/adi-IL/voltcrawl/issues",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "firecrawl",
    "crawler",
    "browser",
    "playwright",
    "ai",
    "coding-agents",
    "research"
  ],
  "bin": {
    "voltcrawl": "bin/cli.js"
  },
  "files": [
    "dist",
    "bin",
    "src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "start": "bun run src/index.ts",
    "start:http": "bun run src/http.ts",
    "build": "bun build src/index.ts src/http.ts --outdir dist --target node",
    "typecheck": "tsc --noEmit",
    "test": "bun test && bun run tests/stdio-test.ts",
    "prepack": "bun run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.6.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5.7.3"
  },
  "engines": {
    "node": ">=20"
  }
}