# ==============================================================================
# voltcrawl Environment Configuration Reference
# ==============================================================================
# Upstream Firecrawl REST API (v2). Default: http://localhost:3002
FIRECRAWL_API_URL=http://localhost:3002

# Optional API key for authenticated Firecrawl instances. Default: (empty)
FIRECRAWL_API_KEY=

# Upstream search proxy for Google Search Grounding. Default: http://localhost:8088
SEARCH_PROXY_URL=http://localhost:8088

# Streamable HTTP Transport Settings (used with --http)
MCP_HTTP_PORT=8787
MCP_HTTP_HOST=127.0.0.1
MASTER_API_KEY=your-secure-master-api-key-here
